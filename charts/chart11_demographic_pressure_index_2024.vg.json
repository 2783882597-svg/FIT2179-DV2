  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "axis": {
      "domainColor": "#e3e8ee",
      "tickColor": "#e3e8ee",
      "gridColor": "#e3e8ee",
      "gridOpacity": 0.7,
      "labelColor": "#64748d",
      "labelFontSize": 11,
      "titleColor": "#273951",
      "titleFontSize": 12
    },
    "font": "Inter, SF Pro Display, system-ui, sans-serif"
  }
}
