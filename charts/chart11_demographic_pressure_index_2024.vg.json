        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "bottom",
        "dx": 8,
        "dy": -118,
        "fontSize": 13,
        "fontWeight": 600,
        "color": "#ea2261"
      },
      "encoding": {
        "x": {
          "field": "score",
          "type": "quantitative",
          "scale": {
            "domain": [0, 100]
          }
